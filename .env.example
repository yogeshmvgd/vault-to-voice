# Path to your Obsidian vault. MUST be outside this repo. Default: ./sample_vault
VAULT_PATH=./sample_vault
DATA_DIR=./data
OUTBOX_DIR=./outbox

# Chat model, "provider:model" (openai:gpt-4o-mini | anthropic:claude-haiku-4-5 | ollama:llama3.1)
LLM_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: local (MiniLM, free) | openai (text-embedding-3-small) | hash (tests only)
EMBEDDING_PROVIDER=local

# Idea detection
MIN_NOTES=4
MIN_OPINIONATED=3
OPINION_THRESHOLD=0.5

# Optional LangSmith tracing: on only when LANGSMITH_TRACING=true AND a key is set
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vault-to-voice

# API (`v2v serve`) and UI (`streamlit run src/vault_to_voice/ui/streamlit_app.py`)
API_HOST=127.0.0.1
API_PORT=8000
V2V_API_URL=http://127.0.0.1:8000

# Vault format: obsidian (daily notes + work pages) | flat (one file per note)
VAULT_FORMAT=obsidian
DAILY_FOLDER=Daily
# Daily note file name format (Python strftime): 10-10-2026.md
DAILY_DATE_FORMAT=%d-%m-%Y
# heading=type pairs; types: game, book, movie, other
CATEGORY_HEADINGS=games=game,books=book,movies=movie
